# How a template sync merges each file. Each merge=<name> below is either built into git or a custom
# strategy from ./bin/merge/<name>.ts.
#
# The rules above the marker line belong to the template, and syncs keep them up to date. Add this
# site's own rules below the marker: a later line overrides an earlier one, so adding
# `src/scaffold/Layout.astro merge=text` there keeps merging the template's changes into this site's
# layout. To simply keep this site's copy of a path, list it in .templatesyncignore instead.

# Combine changes from template and from this site
.gitattributes       merge=union
.templatesyncignore  merge=union
.gitignore           merge=union

# Custom merge strategies
package.json         merge=package-json

# Files each site makes its own: once a site has changed one, it keeps its copy in every sync.
# A site that hasn't changed one keeps following the template.
site-auth.local.json       merge=ours
config.json                merge=ours
README.md                  merge=ours
CHANGELOG.md               merge=ours
.template-sync-ref         merge=ours
src/pages/**               merge=ours
src/scaffold/Layout.astro  merge=ours
src/styles/theme.css       merge=ours
public/favicon.svg         merge=ours

# ---- This site's own rules go below this line ----
