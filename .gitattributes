# How a template sync merges each file.
# Each merge=<name> below is either built into git or a custom strategy from ./bin/merge/<name>.ts.
#
# To ensure no merge conflicts, do not edit this file above the marker line. Lower rules win over higher
# rules, so if this site needs to make changes they should be added as overrides below the marker.
#
# This file enables more complex sync strategies. For simple opt-outs, just add files or paths to
# this site's .templatesyncignore file.

# Combine changes from template and from this site
.gitattributes       merge=union
.templatesyncignore  merge=union
.gitignore           merge=union

# Custom merge strategies
package.json         merge=package-json

# Files each site makes its own: once a site changes one, the site's version is kept in every sync.
# Until one of these files is changed, it keeps following the template.
site-auth.local.json       merge=ours
config.json                merge=ours
README.md                  merge=ours
CHANGELOG.md               merge=ours
.template-sync-ref         merge=ours
src/pages/**               merge=ours
src/scaffold/Layout.astro  merge=ours
src/styles/theme.css       merge=ours
public/favicon.svg         merge=ours

# ---- This site's own rules go below this line ----
