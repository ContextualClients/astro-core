<theme-toggle>
  <fieldset>
    <legend>Theme</legend>
    <label><input type="radio" name="theme-preference" value="system" checked />System</label>
    <label><input type="radio" name="theme-preference" value="light" />Light</label>
    <label><input type="radio" name="theme-preference" value="dark" />Dark</label>
  </fieldset>
</theme-toggle>
<script>
  class ThemeToggle extends HTMLElement {
    private observer = new MutationObserver(() => this.update())
    private update = () => {
      const preference = document.documentElement.dataset.themePreference ?? "system"
      for (const input of this.querySelectorAll("input")) input.checked = input.value === preference
    }
    private change = (event: Event) => {
      if (event.target instanceof HTMLInputElement) document.dispatchEvent(new CustomEvent("theme-change", { detail: event.target.value }))
    }
    connectedCallback() {
      this.addEventListener("change", this.change)
      this.observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme-preference"] })
      this.update()
    }
    disconnectedCallback() {
      this.observer.disconnect()
      this.removeEventListener("change", this.change)
    }
  }
  customElements.define("theme-toggle", ThemeToggle)
</script>
<style>
  fieldset {
    display: inline-flex;
    gap: 2px;
    margin: 0;
    padding: 2px;
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, var(--color-bg));
    border-radius: var(--cds-border-radius-step-0);
  }
  legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  label {
    position: relative;
    padding: var(--cds-space-step--1) var(--cds-space-step-1);
    border-radius: calc(var(--cds-border-radius-step-0) - 2px);
    color: color-mix(in srgb, var(--color-text) 70%, var(--color-bg));
    font-size: .875rem;
    line-height: 1.5;
    cursor: pointer;
  }
  label:hover { color: var(--color-text); }
  label:has(:focus-visible) { outline: 2px solid var(--color-text); outline-offset: 1px; }
  input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  /* The preload script sets data-theme-preference before first paint, so the selection never flashes. */
  :global(:root:not([data-theme-preference="light"], [data-theme-preference="dark"])) label:has([value="system"]),
  :global(:root[data-theme-preference="light"]) label:has([value="light"]),
  :global(:root[data-theme-preference="dark"]) label:has([value="dark"]) {
    background: color-mix(in srgb, var(--color-text) 12%, var(--color-bg));
    color: var(--color-text);
  }
</style>
