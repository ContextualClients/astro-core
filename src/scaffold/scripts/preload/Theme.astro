<script is:inline>
  (() => {
    let preference
    try { preference = localStorage.getItem("theme") } catch {}
    const explicit = preference === "light" || preference === "dark"
    document.documentElement.setAttribute("theme", explicit
      ? preference : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
    document.documentElement.dataset.themePreference = explicit ? preference : "system"
  })()
</script>
<script>
  const systemTheme = matchMedia("(prefers-color-scheme: dark)")
  const readPreference = () => {
    try { return localStorage.getItem("theme") } catch { return undefined }
  }
  let preference = readPreference()
  const applyTheme = (root = document.documentElement) => {
    root.setAttribute("theme", preference === "light" || preference === "dark"
      ? preference : systemTheme.matches ? "dark" : "light")
    root.dataset.themePreference = preference === "light" || preference === "dark" ? preference : "system"
  }
  applyTheme()
  systemTheme.addEventListener("change", () => applyTheme())
  document.addEventListener("astro:before-swap", event => applyTheme(event.newDocument.documentElement))
  window.addEventListener("storage", event => {
    if (event.key !== "theme" && event.key != null) return
    preference = readPreference()
    applyTheme()
  })
  document.addEventListener("theme-change", event => {
    if (!(event instanceof CustomEvent) || !["light", "dark", "system"].includes(event.detail)) return
    preference = event.detail
    applyTheme()
    try { localStorage.setItem("theme", preference ?? "system") } catch {}
  })
</script>
